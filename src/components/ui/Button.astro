---
interface Props { href: string; label: string; variant?: 'solid' | 'line'; magnetic?: boolean; class?: string }
const { href, label, variant = 'line', magnetic = false, class: cls = '' } = Astro.props;
const external = /^https?:/.test(href);
---
<a class:list={['btn', variant === 'solid' && 'btn-solid', cls]} href={href} data-magnetic={magnetic ? '' : undefined}
  target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <span class="roll"><span data-t={label}>{label}</span></span>
</a>
