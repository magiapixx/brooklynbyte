---
// Beranda (desain E · "Studio", disetujui owner 2026-11-09): gabungan referensi Studio Opus (layout putih bersih,
// daftar layanan bernomor, section gelap, pricing, perspectives) dan Mondra (wordmark raksasa, grid karya 2×2,
// workflow 3 kartu, testimoni gambar besar, awards). Aksen biru kini berlaku untuk seluruh situs (global.css).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, services, img } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// Contoh deliverable per layanan (urut sama dengan services di site.json).
const deliver = [
  ['Positioning', 'Naming', 'Logo & identity', 'Brand guidelines', 'Tone of voice'],
  ['Astro & Shopify', 'Headless CMS', 'E-commerce', 'Performance', 'Accessibility'],
  ['User research', 'Flows & wireframes', 'UI design', 'Prototyping', 'Usability tests'],
  ['Frontend', 'iOS & Android', 'APIs & integrations', 'QA', 'Docs & handover'],
  ['Launch films', 'Social motion', 'Interactive pieces', '3D & illustration'],
  ['Analytics setup', 'A/B testing', 'CRO', 'Monthly reports'],
];
// Foto besar per layanan di section We deliver (urut sama dengan services).
const dvImg = ['p-loom', 'p-verde', 'p-signal', 'studio-a', 'p-pulse', 'p-kinfolk'];
// Review klien per layanan (urut sama dengan services): [kutipan, nama, institusi, foto]. Lebih dari satu review = berganti otomatis.
// [CONTOH] Selain tiga review pertama (Orbit Labs, Kinfolk Market, Halcyon Bank), review di sini fiktif untuk mockup; foto memakai foto tim. Ganti dengan review asli klien.
const reviews = [
  [["The best naming process we've ever been through. Calm, fast and backed by research.", 'Marcus Hale', 'Orbit Labs', 'c-2'],
   ['A brand our whole team finally knows how to use.', 'Lena Fischer', 'Atlas Freight', 't-1']],
  [['Our checkout went from eleven steps to three. Revenue followed in the first month.', 'Elena Rossi', 'Kinfolk Market', 'c-3'],
   ['We update the site ourselves now, and it loads in under a second.', 'Omar Haddad', 'Meridian Health', 't-2']],
  [['Collaborating with the team was effortless. They shipped our app redesign in ten weeks and our ratings doubled.', 'Priya Nair', 'Halcyon Bank', 'c-1'],
   ['Every sprint ended with real users testing real screens.', 'Grace Lin', 'Signal', 't-3']],
  [['Clean code, real docs and tests. Our own team ships on it every week.', 'Daniel Park', 'Northwind', 't-4'],
   ['The handover was the smoothest we have ever had.', 'Ben Carter', 'Loom Studio', 't-7']],
  [['The launch film did more for our sign-ups than a year of ads.', 'Sofia Marin', 'Pulse', 't-5'],
   ['People still share the interactive piece months later.', 'Hana Sato', 'Orbit Labs', 't-8']],
  [['Monthly reports we actually read. Every test is tied to a number we care about.', 'Jonas Weber', 'Verde', 't-6'],
   ['Three A/B tests in, conversion was up and the debates were over.', 'Elena Rossi', 'Kinfolk Market', 'c-3']],
];
// Paket (menggantikan Our workflow + Pricing plans): fokus pada manfaat, harga hanya catatan kecil.
// [CONTOH] Nama paket, manfaat, durasi, dan harga fiktif untuk mockup; ganti dengan data asli.
const packages = [
  { name: 'Basic', tag: 'A sharp start for a new product.', time: '2–3 weeks', from: '$4,000',
    items: ['Logo and core visual identity', 'A fast one-page website', 'Social media starter kit', 'Two rounds of revisions', '14 days of launch support'] },
  { name: 'Plus', tag: 'For teams ready to grow.', time: '4–6 weeks', from: '$9,000', badge: 'Most chosen',
    items: ['Everything in Basic', 'A multi-page site you can edit yourself', 'UI design for your key product screens', 'Analytics and conversion setup', '30 days of launch support'] },
  { name: 'Identity', tag: 'A complete brand, built to last.', time: '6–10 weeks', from: '$15,000',
    items: ['Brand strategy and positioning', 'Naming support and tone of voice', 'Full visual identity and guidelines', 'Website, motion and launch assets', 'A dedicated senior lead'] },
];
---
<BaseLayout title="Brooklynbyte" description="Brooklynbyte is an independent design and engineering studio in Brooklyn. Strategy, brand, websites and products for startups and growing companies.">
  <!-- 1. Hero: meta + angka, foto lebar, wordmark raksasa -->
  <section class="e-hero" data-mood="paper" aria-labelledby="e-h1">
    <div class="wrap e-hero-top">
      <div class="e-hero-meta" data-intro>
        <p class="type-small muted">Brooklyn, NY<br />Est. 2016</p>
        <div class="e-faces" aria-hidden="true">{[0, 1, 2].map((k) => <Image src={img(`t-${k + 1}`)} alt="" width={88} height={88} />)}</div>
        <p class="type-small">24 people who<br />ship every week</p>
      </div>
      <div class="e-hero-lead" data-intro>
        <h1 id="e-h1" class="e-lead">Strategy, brand, websites and products for companies ready for change.</h1>
        <dl class="e-mini">
          <div><dd>10</dd><dt>Years of practice</dt></div>
          <div><dd>140+</dd><dt>Products shipped</dt></div>
          <div><dd>32</dd><dt>Awards</dt></div>
        </dl>
      </div>
    </div>
    <div class="e-hero-img" data-clip><Image src={img('studio-a')} alt="Abstract blue 3D render" widths={[800, 1400, 2200]} sizes="100vw" loading="eager" /></div>
    <p class="e-word" aria-hidden="true"><span>brooklyn</span><b>byte</b></p>
  </section>

  <!-- 2. Intro: kalimat besar dengan tiga foto kapsul di antara kata (melebar saat terlihat); kata abu-abu menjadi hitam mengikuti scroll -->
  <section class="sec e-intro io2" data-mood="paper" aria-label="About us">
    <div class="wrap">
      <p class="io2-t" data-scrub>We are a design <span class="io-pic" aria-hidden="true"><Image src={img('studio-b')} alt="" widths={[300, 600]} sizes="16vw" loading="lazy" /></span> and engineering studio driven by a love for clear ideas, honest interfaces <span class="io-pic" aria-hidden="true"><Image src={img('p-signal')} alt="" widths={[300, 600]} sizes="16vw" loading="lazy" /></span> and code that lasts. We partner with founders and teams to build brands <span class="io-pic" aria-hidden="true"><Image src={img('studio-a')} alt="" widths={[300, 600]} sizes="16vw" loading="lazy" /></span> and products people come back to.</p>
    </div>
  </section>

  <!-- 3. Selected works: foto proyek selebar layar, nama klien raksasa di atas foto -->
  <section class="sec e-wk" data-mood="paper" aria-labelledby="e-works">
    <div class="wrap e-head">
      <h2 class="e-h2" id="e-works" data-split>Selected works <sup>({projects.length})</sup></h2>
      <a class="ulink type-small" href="/projects/">View all →</a>
    </div>
    <div class="e-wk-list">
      {projects.slice(0, 4).map((p, i) => (
        <a class="e-wk-item" href={`/projects/${p.id}/`} data-cursor="View">
          <div class="e-wk-img"><Image src={p.data.cover} alt={p.data.coverAlt} widths={[900, 1600, 2400]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} /></div>
          <div class="wrap e-wk-cap">
            <span class="e-wk-n type-small">{pad(i + 1)} / {pad(projects.length)}</span>
            <h3 class="e-wk-t">{p.data.client}</h3>
            <ul class="e-wk-tags"><li class="is-res">{p.data.result}</li><li>{p.data.categoryLabel}</li><li>{p.data.year}</li></ul>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. We deliver: daftar layanan di kiri, foto raksasa menempel di kanan dan berganti mengikuti layanan yang aktif -->
  <section class="sec e-dv2" data-mood="paper" aria-labelledby="e-deliver">
    <div class="wrap e-dv2-head">
      <h2 class="e-h2" id="e-deliver" data-split>We deliver</h2>
      <p class="e-big" data-split>Every service has a common thread: a clear purpose. It's not about adding more, it's about giving your product direction.</p>
      <dl class="e-mini">
        <div><dd data-count="140" data-suffix="+">140+</dd><dt>Projects done</dt></div>
        <div><dd data-count="40" data-suffix="+">40+</dd><dt>Global clients</dt></div>
        <div><dd data-count="32">32</dd><dt>Our awards</dt></div>
      </dl>
    </div>
    <div class="e-dv2-grid">
      <ol class="e-dv2-list">
        {services.map((s, i) => (
          <li class:list={['e-dv2-item', { 'is-on': i === 0 }]} data-i={i} style={`--i:${i}`}>
            <div class="e-dv2-mimg"><Image src={img(dvImg[i])} alt="" widths={[600, 1000]} sizes="92vw" loading="lazy" /></div>
            <span class="e-dv2-n">{pad(i + 1)}</span>
            <h3 class="e-dv2-t">{s.name}</h3>
            <p class="muted">{s.description}</p>
            <ul class="e-dv2-tags">{deliver[i].map((d) => <li>{d}</li>)}</ul>
            <div class="dv-rv" data-rv aria-label="Client reviews">
              {reviews[i].map(([q, n, c, f], k) => (
                <figure class:list={['dv-rv-i', { 'is-on': k === 0 }]} aria-hidden={k === 0 ? undefined : 'true'}>
                  <Image src={img(f)} alt="" width={64} height={64} />
                  <figcaption><b>{n}</b> · {c}</figcaption>
                  <blockquote>“{q}”</blockquote>
                </figure>
              ))}
            </div>
          </li>
        ))}
      </ol>
      <div class="e-dv2-media" aria-hidden="true">
        {services.map((_, i) => <div class:list={['e-dv2-img', { 'is-on': i === 0 }]} data-i={i}><Image src={img(dvImg[i])} alt="" widths={[900, 1600, 2200]} sizes="60vw" loading="lazy" /></div>)}
        <span class="e-dv2-count"><b data-dvn>01</b> / {pad(services.length)}</span>
      </div>
    </div>
  </section>

  <!-- 5. Choose your package: kartu paket mendatar bertingkat (Basic → Identity), nama paket tegak di kiri, manfaat di depan, harga kecil; Plus berlatar biru -->
  <section class="sec e-pk" data-mood="paper" aria-labelledby="e-pkg">
    <div class="wrap">
      <div class="e-head">
        <h2 class="e-h2" id="e-pkg" data-split>Choose your package</h2>
        <p class="type-small muted e-pkg-side">Every package comes with one senior team.<br />Pick the level that fits where you are.</p>
      </div>
      <ol class="e-pkgs">
        {packages.map((p, i) => (
          <li class:list={['e-pkg', { 'is-acc': i === 1 }]}>
            <header>
              <span class="e-pkg-n">{i + 1}.</span>
              {p.badge && <span class="e-badge">{p.badge}</span>}
            </header>
            <div class="e-pkg-top">
              <h3 class="e-pkg-name">{p.name}</h3>
              <p class="e-pkg-tag">{p.tag}</p>
            </div>
            <ul class="e-pkg-list">{p.items.map((it) => <li>{it}</li>)}</ul>
            <footer>
              <p class="e-pkg-meta">{p.time} · from {p.from}</p>
              <a class="e-pkg-go" href={SITE.whatsapp} aria-label={`Start with ${p.name}`}><span>Start with {p.name}</span><i aria-hidden="true">↗</i></a>
            </footer>
          </li>
        ))}
      </ol>
      <p class="type-caption muted e-fine">Packages and prices are examples for this mockup.</p>
    </div>
  </section>

  <!-- 10. Perspectives: kartu editorial asimetris, satu unggulan dan dua kartu pendamping -->
  <section class="sec e-ps" data-mood="paper" aria-labelledby="e-persp">
    <div class="wrap">
      <div class="e-persp-head">
        <h2 class="e-h2" id="e-persp" data-split>Our perspectives</h2>
        <p class="type-small muted">Ideas on design, technology and building things that last.</p>
        <a class="e-persp-all" href="/blog/">All articles <span aria-hidden="true">→</span></a>
      </div>
      <ul class="e-persp" data-stagger>
        {posts.map((b) => (
          <li><a class="e-persp-card" href={`/blog/${b.id}/`} data-cursor="Read">
            <Image class="e-persp-img" src={b.data.cover} alt="" widths={[500, 900]} sizes="(min-width:1024px) 32vw, (min-width:640px) 48vw, 100vw" loading="lazy" />
            <time class="e-persp-date type-caption" datetime={b.data.date.toISOString()}>{fmt(b.data.date)}</time>
            <div class="e-persp-copy">
              <span class="e-persp-meta type-small">{b.data.tag}</span>
              <h3 class="e-persp-t">{b.data.title}</h3>
            </div>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(SplitText, ScrollTrigger);
  const root = document.documentElement;
  // Wordmark hero: huruf naik satu per satu saat halaman dibuka, lalu bergeser pelan mengikuti scroll.
  const run = () => {
    if (root.classList.contains('no-motion')) return;
    const word = document.querySelector<HTMLElement>('.e-word');
    if (word) {
      const s = new SplitText(word.querySelectorAll('span, b'), { type: 'chars', aria: 'none' });
      gsap.from(s.chars, { yPercent: 110, duration: 1.1, ease: 'power4.out', stagger: 0.035, delay: 0.25 });
      gsap.to(word, { xPercent: -4, ease: 'none', scrollTrigger: { trigger: '.e-hero', start: 'top top', end: 'bottom top', scrub: true } });
    }
    const img = document.querySelector('.e-hero-img img');
    if (img) gsap.to(img, { yPercent: -12, ease: 'none', scrollTrigger: { trigger: '.e-hero-img', start: 'top top', end: 'bottom top', scrub: true } });
    // Elemen di atas foto bergeser sedikit ke kanan saat scroll, mengimbangi wordmark di bawah foto yang bergeser ke kiri.
    gsap.to('.e-hero-meta, .e-hero-lead', { x: () => innerWidth * 0.04, ease: 'none', scrollTrigger: { trigger: '.e-hero', start: 'top top', end: 'bottom top', scrub: true, invalidateOnRefresh: true } });
  };
  // We deliver: layanan di tengah layar menjadi aktif; foto besar berganti (tirai dari bawah).
  const items = [...document.querySelectorAll<HTMLElement>('.e-dv2-item')];
  const imgs = [...document.querySelectorAll<HTMLElement>('.e-dv2-img')];
  const num = document.querySelector<HTMLElement>('[data-dvn]');   if (!root.classList.contains('no-motion')) {     items.forEach((it, i) => gsap.from(it, {       y: 32,       opacity: 0,       duration: 0.8,       delay: i * 0.06,       ease: 'power3.out',       clearProps: 'transform,opacity',       scrollTrigger: { trigger: it, start: 'top 88%', once: true },     }));   }   const mobileImageMotion = gsap.matchMedia();   mobileImageMotion.add('(max-width: 767px)', () => {     if (root.classList.contains('no-motion')) return;     const frames = gsap.utils.toArray<HTMLElement>('.e-dv2-mimg');     frames.forEach((frame) => {       const image = frame.querySelector('img');       if (!image) return;       const list = frame.closest<HTMLElement>('.e-dv2-list');       if (!list) return;       const gutter = parseFloat(getComputedStyle(list).paddingLeft);       gsap.fromTo(frame, { marginLeft: 0, marginRight: 0, marginTop: 0 }, {         marginLeft: -gutter,         marginRight: -gutter,         marginTop: -gutter,         borderRadius: 0,         ease: 'none',         scrollTrigger: { trigger: frame, start: 'top 88%', end: 'top 50%', scrub: true },       });       gsap.fromTo(image, { scale: 1.08 }, {         scale: 1,         ease: 'none',         scrollTrigger: { trigger: frame, start: 'top 88%', end: 'top 50%', scrub: true },       });     });     return () => frames.forEach((frame) => {       gsap.set(frame, { clearProps: 'marginLeft,marginRight,marginTop,borderRadius' });       gsap.set(frame.querySelector('img'), { clearProps: 'transform' });     });   });
  // HP: tinggi tiap kartu layanan disimpan di --h untuk aturan sticky "kartu menumpuk" (lihat CSS .e-dv2-item).
  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver((entries) => entries.forEach((e) => (e.target as HTMLElement).style.setProperty('--h', `${(e.target as HTMLElement).offsetHeight}px`)));
    items.forEach((it) => ro.observe(it));
  }
  const activate = (i: number) => {
    items.forEach((it, k) => it.classList.toggle('is-on', k === i));
    imgs.forEach((im, k) => { im.classList.toggle('is-on', k === i); im.style.zIndex = k === i ? '1' : '0'; });
    if (num) num.textContent = String(i + 1).padStart(2, '0');
  };
  items.forEach((it, i) => ScrollTrigger.create({ trigger: it, start: 'top 55%', end: 'bottom 55%', onToggle: (st) => { if (st.isActive) activate(i); } }));
  // Selected works: foto bergerak pelan (parallax) dan judul naik saat kartu masuk layar.
  const outro = () => {
    if (root.classList.contains('no-motion')) return;
    const ct = document.querySelector<HTMLElement>('.e-cta-t');
    if (ct) { const sp = new SplitText(ct, { type: 'words', aria: 'none' }); gsap.from(sp.words, { yPercent: 60, opacity: 0, duration: 0.9, ease: 'power4.out', stagger: 0.04, scrollTrigger: { trigger: '.e-cta', start: 'top 70%' } }); }
  };
  const works = () => {
    if (root.classList.contains('no-motion')) return;
    document.querySelectorAll<HTMLElement>('.e-wk-item').forEach((it) => {
      gsap.fromTo(it.querySelector('img'), { yPercent: 0 }, { yPercent: -12, ease: 'none', scrollTrigger: { trigger: it, start: 'top bottom', end: 'bottom top', scrub: true } });
      gsap.from(it.querySelector('.e-wk-img'), { clipPath: 'inset(8% 6% 8% 6% round 32px)', ease: 'none', scrollTrigger: { trigger: it, start: 'top bottom', end: 'top 25%', scrub: true } });
      gsap.from(it.querySelectorAll('.e-wk-t, .e-wk-tags li'), { yPercent: 60, opacity: 0, duration: 0.9, ease: 'power3.out', stagger: 0.06, scrollTrigger: { trigger: it, start: 'top 60%' } });
    });
  };
  // Review kapsul: bila lebih dari satu, berganti tiap 4,5 detik (naik keluar, masuk dari bawah) selama terlihat; berhenti saat hover.
  document.querySelectorAll<HTMLElement>('[data-rv]').forEach((box) => {
    const its = [...box.querySelectorAll<HTMLElement>('.dv-rv-i')];
    if (its.length < 2 || root.classList.contains('no-motion')) return;
    let cur = 0, seen = false, hold = false;
    box.addEventListener('pointerenter', () => { hold = true; });
    box.addEventListener('pointerleave', () => { hold = false; });
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; }).observe(box);
    setInterval(() => {
      if (!seen || hold || document.hidden) return;
      const prev = its[cur]; cur = (cur + 1) % its.length; const next = its[cur];
      its.forEach((x) => x.classList.remove('is-out'));
      prev.classList.remove('is-on'); prev.classList.add('is-out'); prev.setAttribute('aria-hidden', 'true');
      next.classList.add('is-on'); next.removeAttribute('aria-hidden');
    }, 4500);
  });
  // Intro: kata abu-abu menjadi hitam mengikuti scroll; foto kapsul melebar saat terlihat.
  const intro = () => {
    if (root.classList.contains('no-motion')) return;
    const sc = document.querySelector<HTMLElement>('[data-scrub]');
    if (sc) { const sp = new SplitText(sc, { type: 'words', aria: 'none' }); gsap.fromTo(sp.words, { opacity: 0.5 }, { opacity: 1, ease: 'none', stagger: 0.1, scrollTrigger: { trigger: sc, start: 'top 80%', end: 'bottom 40%', scrub: true } }); }
    gsap.utils.toArray<HTMLElement>('.io-pic').forEach((pic) => gsap.from(pic, { width: 0, marginInline: 0, duration: 1.1, ease: 'power4.inOut', clearProps: 'width,marginInline', scrollTrigger: { trigger: pic.parentElement!, start: 'top 75%', toggleActions: 'play none none reverse' } }));
  };
  // Kartu paket: desktop = kartu mendatar masuk dari kiri ke kanan (geser + tirai terbuka ke kanan), satu per satu; HP = naik.
  const pk = () => {
    if (root.classList.contains('no-motion')) return;
    const cards = gsap.utils.toArray<HTMLElement>('.e-pkg');
    const list = document.querySelector('.e-pkgs');
    if (!list) return;
    if (!matchMedia('(min-width: 1024px)').matches) { gsap.from(cards, { y: 48, opacity: 0, duration: 0.9, ease: 'power3.out', stagger: 0.07, scrollTrigger: { trigger: list, start: 'top 85%' } }); return; }
    cards.forEach((c, i) => gsap.timeline({ scrollTrigger: { trigger: list, start: 'top 75%' }, delay: i * 0.15 })
      .fromTo(c, { x: () => -innerWidth * 0.25, clipPath: 'inset(0% 100% 0% 0% round 32px)' }, { x: 0, clipPath: 'inset(0% 0% 0% 0% round 32px)', duration: 1.2, ease: 'power4.inOut', clearProps: 'clipPath' })
      .from(c.querySelectorAll('.e-pkg-list li'), { x: -40, opacity: 0, duration: 0.6, ease: 'power3.out', stagger: 0.05 }, '-=0.5'));
  };
  (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => requestAnimationFrame(() => { run(); works(); outro(); intro(); pk(); }));
</script>

<style>
  /* Lebar konten semua section = hero & footer (tepi layar dikurangi gutter, tanpa batas 1600px) */
  :global(main .wrap), :global(.site-header .wrap) { max-width: none; }
  :global(html body .wa) { background: #fff; color: oklch(.45 .2 262); }
  :global(html body .wa::after) { border-color: #fff; }
  /* Section gelap di halaman ini benar-benar hitam seperti referensi */

  .e-h2 { font-size: var(--text-4xl); line-height: 1; letter-spacing: -0.04em; font-weight: 500; }
  .e-h2 sup { font-size: .32em; vertical-align: top; letter-spacing: 0; color: var(--color-muted); }
  .e-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 56px); }
  .e-white { color: #fff; }
  .e-mini { display: flex; gap: clamp(20px, 3vw, 48px); margin: 0; }
  .e-mini dd { margin: 0; font-size: var(--text-3xl); line-height: 1; letter-spacing: -0.04em; font-weight: 500; font-variant-numeric: tabular-nums; }
  .e-mini dt { font-size: var(--text-xs); color: var(--color-muted); margin-top: 8px; max-width: 12ch; }
  .e-mini > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .e-mini > div:nth-child(2) dd { color: var(--color-accent); }

  /* 1. Hero */
  .e-hero { padding-top: 120px; overflow: clip; }
  .e-hero-top { display: grid; gap: 32px; margin-bottom: clamp(24px, 3vw, 40px); }
  .e-hero-meta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .e-faces { display: flex; }
  .e-faces img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid var(--color-bg); margin-left: -10px; }
  .e-faces img:first-child { margin-left: 0; }
  .e-hero-lead { display: grid; gap: 28px; }
